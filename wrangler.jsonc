/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "03-digital-pp",
	"main": ".svelte-kit/cloudflare/_worker.js",
	// Search index refresh — every 6 hours is far more often than the
	// post cadence; the manual /api/search/reindex endpoint remains
	// the "I just posted" override.
	"triggers": {
		"crons": ["0 */6 * * *"]
	},
	"compatibility_date": "2025-08-05",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
        "kv_namespaces": [
    {
      "binding": "CONTACT_KV",
      "id": "46f04b24d94c472f8e718f14562a17ae"
    }
  ],

       /* Workers AI — native binding, no API token needed at runtime */
       "ai": {
    "binding": "AI"
  },

       /* Vectorize — semantic index for the blog search (768d cosine,
          matches @cf/baai/bge-base-en-v1.5 embeddings) */
       "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "pp-blog-search"
    }
  ],

       "secrets_store_secrets": [
	  {
	    "binding": "CLOUDFLARE_API_TOKEN",
	    "store_id": "1da7c182b2d345e9bc6a8f83421d23a7",
	    "secret_name": "CLOUDFLARE_API_TOKEN"
	  }
	],

	"vars": {
                "MAILGUN_DOMAIN": "pinchepoutine.digital",
	       	"CONTACT_EMAIL": "contact@pinchepoutine.digital",
	       	"MAILGUN_FROM_EMAIL": "noreply@pinchepoutine.digital",
		// Turnstile — public sitekey (TEST key: always passes; replace with the
		// real widget key when created in dash.cloudflare.com → Turnstile).
		// The secret is a wrangler secret: TURNSTILE_SECRET.
		"TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
        },
        "d1_databases": [
                {
                        "binding": "DB",
                        "database_name": "subscribers-db",
                        "database_id": "215a6b19-a550-4d91-acd9-dcf756dc9438"
                }
        ],

	// --- Staging environment --- isolated D1/KV/Vectorize so staging
	// subscribe tests, contact submissions and search reindexes never
	// touch prod data or the prod vector index (02-ca-patrouch precedent).
	// Deploys as 03-digital-pp-staging on staging.pinchepoutine.digital.
	// MAILGUN_API_KEY still needs a one-time `wrangler secret put
	// MAILGUN_API_KEY --env staging` — worker secrets aren't inherited.
	"env": {
		"staging": {
			"workers_dev": true,
			"routes": [{ "pattern": "staging.pinchepoutine.digital", "custom_domain": true }],
			// Bindings are not inherited by environments — mirror the
			// top-level ones, pointed at the staging resources.
			"secrets_store_secrets": [
				{
					"binding": "CLOUDFLARE_API_TOKEN",
					"store_id": "1da7c182b2d345e9bc6a8f83421d23a7",
					"secret_name": "CLOUDFLARE_API_TOKEN"
				}
			],
			"vars": {
				"MAILGUN_DOMAIN": "pinchepoutine.digital",
				"CONTACT_EMAIL": "contact@pinchepoutine.digital",
				"MAILGUN_FROM_EMAIL": "noreply@pinchepoutine.digital",
		// Turnstile — public sitekey (TEST key: always passes; replace with the
		// real widget key when created in dash.cloudflare.com → Turnstile).
		// The secret is a wrangler secret: TURNSTILE_SECRET.
		"TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
			},
			"kv_namespaces": [
				{
					"binding": "CONTACT_KV",
					"id": "856673f643a24c1baf6aff8ece4d7a64"
				}
			],
			"ai": {
				"binding": "AI"
			},
			"vectorize": [
				{
					"binding": "VECTORIZE",
					"index_name": "pp-blog-search-staging"
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "subscribers-db-staging",
					"database_id": "b2cb5ec5-8e55-4ab4-aa39-205227f9e660"
				}
			]
		}
	},
        /**
         * Note: Set MAILGUN_API_KEY as a secret using:
         * wrangler secret put MAILGUN_API_KEY
         */



	/**
	 * Smart Placement
	 * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": { "mode": "smart" },

	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare D,eveloper Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */

	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 */
	// "vars": { "MY_VARIABLE": "production_value" },
	/**
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */

	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": { "directory": "./public/", "binding": "ASSETS" },

	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
}
